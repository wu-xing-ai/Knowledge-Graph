# ===== 知联汇学环境变量模板（本地开发用）=====
# 复制本文件为 .env 并填入真实值（.env 已被 gitignore 忽略，不会提交）
#
# ⚠️ 下面的数据库密码是【示例值】：MySQL 密码 wjx1314520、Neo4j 密码 neo4j
#    正式环境请务必改成自己的强密码，不要照抄！

# ---------- MySQL 数据库 ----------
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=wjx1314520

# ---------- Neo4j 图数据库 ----------
SPRING_NEO4J_AUTHENTICATION_USERNAME=neo4j
SPRING_NEO4J_AUTHENTICATION_PASSWORD=neo4j

# ---------- 本平台初始管理员密码 ----------
# 部署时会把 sys_user 表中 admin 的密码重置为该值（BCrypt 加密存储）
ADMIN_PASSWORD=123456

# ---------- JWT 签名密钥（>=32 字符，建议用随机串）----------
JWT_SECRET=example_change_me_to_a_long_random_secret_32plus

# ---------- 云端 AI 服务 ----------
# 云端 PaddleOCR（AI Studio）token
PADDLE_OCR_TOKEN=your_paddle_ocr_token_here
# 魔搭 ModelScope API key（云端 LLM 抽取用）
MODELSCOPE_API_KEY=your_modelscope_api_key