# ===== 生产环境密钥（复制为 /etc/zhi-platform.env 并填写真实值）=====
# ⚠️ 下面是【示例密码】，正式环境务必改成自己的强密码！
# JWT 密钥：务必改成一个足够长的随机字符串（>=32位），不要用示例值
JWT_SECRET=change_me_to_a_long_random_secret_string_32_plus_chars

# MySQL（示例：root / wjx1314520）
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/zhi_platform?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=wjx1314520

# Neo4j（示例：neo4j / neo4j）
SPRING_NEO4J_URI=bolt://localhost:7687
SPRING_NEO4J_AUTHENTICATION_USERNAME=neo4j
SPRING_NEO4J_AUTHENTICATION_PASSWORD=neo4j

# 云端服务密钥
MODELSCOPE_API_KEY=your_modelscope_api_key
PADDLE_OCR_TOKEN=your_paddle_ocr_token_here